<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><Version>0.3.0</Version></PropertyGroup>
  <PropertyGroup>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/..'))=/_/asmarr</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <Content Include="providers/**/*.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RecordPublishIdentity" AfterTargets="Publish">
    <WriteLinesToFile File="$(PublishDir)build-identity.json" Lines="{&quot;sourceCommit&quot;:&quot;$(SourceRevisionId)&quot;,&quot;version&quot;:&quot;$(Version)&quot;}" Overwrite="true" />
    <WriteLinesToFile File="$(PublishDir)build-files.txt" Lines="@(ResolvedFileToPublish->'%(RelativePath)');@(_PublishStaticWebAssetsTargetPath->'%(TargetPath)');$(TargetName).staticwebassets.endpoints.json;build-identity.json;build-files.txt" Overwrite="true" />
  </Target>
</Project>
